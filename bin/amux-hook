#!/usr/bin/env python3
"""amux-hook: feed Claude Code hook events into the amux sidebar.

Register it for every event in ~/.claude/settings.json:

    "hooks": {
      "SessionStart":     [{"hooks": [{"type": "command", "command": "~/amux/bin/amux-hook"}]}],
      "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "~/amux/bin/amux-hook"}]}],
      "PreToolUse":       [{"hooks": [{"type": "command", "command": "~/amux/bin/amux-hook"}]}],
      "Notification":     [{"hooks": [{"type": "command", "command": "~/amux/bin/amux-hook"}]}],
      "Stop":             [{"hooks": [{"type": "command", "command": "~/amux/bin/amux-hook"}]}],
      "PreCompact":       [{"hooks": [{"type": "command", "command": "~/amux/bin/amux-hook"}]}],
      "SessionEnd":       [{"hooks": [{"type": "command", "command": "~/amux/bin/amux-hook"}]}]
    }

Claude Code passes the event as JSON on stdin; the pane comes from $TMUX_PANE
and the server from $TMUX, so the right pane is updated even when several
agents run at once. Outside amux (or under a plain tmux) it does nothing.
Set AMUX_BIN to use another binary than ~/amux/tmux.
"""
import json
import os
import subprocess
import sys


def main():
    tmux = os.environ.get("TMUX")
    pane = os.environ.get("TMUX_PANE")
    if not tmux or not pane:
        return
    sock = tmux.split(",")[0]
    binary = os.environ.get("AMUX_BIN", os.path.expanduser("~/amux/tmux"))

    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    if not isinstance(data, dict):
        data = {}
    event = data.get("hook_event_name") or (sys.argv[1] if len(sys.argv) > 1 else "")

    def short(text, n=44):
        text = " ".join(str(text or "").split())
        return text if len(text) <= n else text[: n - 1] + "…"

    def notify(*args):
        def run(argv):
            return subprocess.run(
                [binary, "-S", sock, "notify", "-t", pane, *argv],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
            ).returncode

        try:
            if run(list(args)) != 0 and "-a" in args:
                # Older amux server without -a: drop the activity text.
                rest, skip = [], False
                for a in args:
                    if skip:
                        skip = False
                        continue
                    if a == "-a":
                        skip = True
                        continue
                    rest.append(a)
                if rest:
                    run(rest)
        except Exception:
            pass

    if event == "SessionStart":
        notify("-s", "running", "-a", "ready")
    elif event == "UserPromptSubmit":
        notify("-s", "busy", "-a", "prompt: " + short(data.get("prompt", "")))
    elif event == "PreToolUse":
        tool = data.get("tool_name", "") or "tool"
        ti = data.get("tool_input") or {}
        if not isinstance(ti, dict):
            ti = {}
        detail = (
            ti.get("command")
            or ti.get("file_path")
            or ti.get("pattern")
            or ti.get("url")
            or ti.get("description")
            or ti.get("prompt")
            or ""
        )
        notify("-s", "busy", "-a", short(f"{tool}: {detail}" if detail else tool))
    elif event == "Notification":
        message = short(data.get("message", "") or "needs you", 40)
        notify("-s", "waiting", "-l", "warn", "-a", message, message)
    elif event == "Stop":
        notify("-s", "done", "-l", "ok", "-a", "", "finished")
    elif event == "PreCompact":
        notify("-a", "compacting…")
    elif event == "SessionEnd":
        notify("-s", "auto", "-a", "")


if __name__ == "__main__":
    main()
